# Start with the interface only. No wallet, API key or Solana CLI is required.
# Set to 0 to enable a real localnet or devnet ledger. Ignored on Vercel.
FAIRTIX_UI_ONLY=1
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=devnet
# Development only. For Vercel, use SOLANA_SPONSOR_KEY as a JSON array instead.
SOLANA_SPONSOR_KEY_PATH=.keys/sponsor.json
SOLANA_CURRENCY_MINT=
FAIRTIX_DEMO_EVENT=
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_SITE_URL=http://localhost:3034
# Display a disabled example ticket while programs are not deployed.
FAIRTIX_PREVIEW=0
# Optional comma-separated event addresses excluded from the public calendar.
FAIRTIX_EXCLUDED_EVENTS=
