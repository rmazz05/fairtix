{
  "name": "fairtix",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3034",
    "build": "next build",
    "start": "next start --port 3034",
    "typecheck": "tsc --noEmit",
    "test:chain": "tsx scripts/test-chain.ts",
    "seed": "tsx scripts/seed.ts",
    "keys:local": "tsx scripts/local-keys.ts",
    "build:chain": "bash scripts/build-chain.sh",
    "validator": "bash scripts/local-validator.sh",
    "test:http": "tsx scripts/test-http.ts",
    "test:rpc": "tsx scripts/test-rpc.ts",
    "test:resilience": "tsx scripts/test-resilience.ts",
    "test": "npm run test:rpc && npm run test:resilience",
    "setup:local": "tsx scripts/setup-local.ts && npm run keys:local",
    "rpc:check": "tsx scripts/check-rpc.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.32.1",
    "@phosphor-icons/react": "2.1.10",
    "@privy-io/react-auth": "3.46.0",
    "@solana-program/memo": "0.15.0",
    "@solana-program/system": "0.15.0",
    "@solana-program/token": "0.17.0",
    "@solana/kit": "8.4.0",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.98.4",
    "next": "16.3.8",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.2",
    "@types/node": "22.19.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.2.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "jayson": "4.1.3",
    "rpc-websockets": "9.3.8",
    "ws": "8.22.0",
    "toml": "5.0.0"
  }
}
